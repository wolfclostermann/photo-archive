# Hot storage — fast access (e.g. OneDrive, Google Drive)
ONEDRIVE_REMOTE=onedrive:Photos/Shoots
ONEDRIVE_LIGHTROOM_REMOTE=onedrive:Photos/Lightroom

# Cold storage — archival (e.g. Backblaze B2, AWS Glacier)
B2_REMOTE=b2:your-bucket/Shoots
B2_LIGHTROOM_REMOTE=b2:your-bucket/Lightroom

# Local paths (defaults shown)
LOCAL_SHOOTS=/Users/you/Pictures/Shoots
LOCAL_LIGHTROOM=/Users/you/Pictures/Lightroom
